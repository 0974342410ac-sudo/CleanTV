<?xml version="1.0" encoding="utf-8"?>
<!-- Search over the playing video (PlayerSearch): a low strip across the top of the picture, results in one row.
     The song goes on below it, and the karaoke lyrics, at the bottom of the video, stay in sight. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:background="@drawable/search_panel_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="10dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/ps_query"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/search_bg"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:drawableTint="#80FFFFFF"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:maxLines="1"
            android:nextFocusDown="@id/ps_results"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/ps_mic"
            style="@style/TopButton"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/ic_mic"
            android:drawablePadding="4dp"
            android:drawableTint="@color/button_text"
            android:nextFocusDown="@id/ps_results"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/mic"
            android:textSize="14sp" />

        <Button
            android:id="@+id/ps_tab_trending"
            style="@style/TopButton"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:nextFocusDown="@id/ps_results"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/nav_trending"
            android:textSize="14sp" />

        <Button
            android:id="@+id/ps_tab_favorites"
            style="@style/TopButton"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:nextFocusDown="@id/ps_results"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/nav_favorites"
            android:textSize="14sp" />

        <Button
            android:id="@+id/ps_tab_singers"
            style="@style/TopButton"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:nextFocusDown="@id/ps_results"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/nav_singers"
            android:textSize="14sp" />

        <Button
            android:id="@+id/ps_tab_genres"
            style="@style/TopButton"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:nextFocusDown="@id/ps_results"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/nav_genres"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ps_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFF6FA0"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:text="@string/ps_hint"
            android:textColor="@color/dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- The strip's own keyboard (StripKeyboard): OK on the text box opens it, it stays above the lyrics -->
    <LinearLayout
        android:id="@+id/ps_keys"
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ps_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:paddingEnd="20dp" />
</LinearLayout>
